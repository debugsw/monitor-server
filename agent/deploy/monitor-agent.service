[Unit]
Description=Monitor Linux Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=monitor-agent
Group=monitor-agent
EnvironmentFile=/etc/monitor-agent/agent.env
ExecStart=/usr/bin/java -jar /opt/monitor-agent/monitor-agent.jar
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
